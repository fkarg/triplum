ation algorithms"},{"question_id":null,"document_id":"scierc:train:25","subject":"structure-sharing","predicate":"Used-for","object":"method"},{"question_id":null,"document_id":"scierc:train:26","subject":"scheme","predicate":"Used-for","object":"cyclic structures"},{"question_id":null,"document_id":"scierc:train:26","subject":"quasi-destructive scheme 's ability","predicate":"Feature-of","object":"scheme"},{"question_id":null,"document_id":"scierc:train:26","subject":"over copying","predicate":"Conjunction","object":"early copying"},{"question_id":null,"document_id":"scierc:train:27","subject":"system","predicate":"Used-for","object":"subcategorization dictionary"},{"question_id":null,"document_id":"scierc:train:27","subject":"textual corpora","predicate":"Used-for","object":"system"},{"question_id":null,"document_id":"scierc:train:30","subject":"system","predicate":"Used-for","object":"subcategorization dictionary"},{"question_id":null,"document_id":"scierc:train:30","subject":"accuracy","predicate":"Evaluate-for","object":"parser"},{"question_id":null,"document_id":"scierc:train:30","subject":"parser","predicate":"Evaluate-for","object":"subcategorization dictionary"},{"question_id":null,"document_id":"scierc:train:33","subject":"maximum mutual information","predicate":"Hyponym-of","object":"registration criteria"},{"question_id":null,"document_id":"scierc:train:34","subject":"low-level criterion","predicate":"Feature-of","object":"it"},{"question_id":null,"document_id":"scierc:train:36","subject":"Bayesian framework","predicate":"Used-for","object":"image registration methods"},{"question_id":null,"document_id":"scierc:train:36","subject":"statistically learned prior knowledge","predicate":"Used-for","object":"image registration methods"},{"question_id":null,"document_id":"scierc:train:36","subject":"joint intensity distribution","predicate":"Feature-of","object":"statistically learned prior knowledge"},{"question_id":null,"document_id":"scierc:train:37","subjec